---
/**
 * Empresa — SPEC §14.
 * Secciones: historia, línea temporal, fábrica, proceso, calidad,
 * equipo, cobertura, logística, compromiso.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Empresa', url: '/empresa' },
];

const timeline = [
  { year: '1975', text: 'Inicio de la actividad de la empresa (declaración comercial).', pending: true },
  { year: '—', text: 'Primeras instalaciones y horno.', pending: true },
  { year: '—', text: 'Ampliaciones de planta y nuevas líneas.', pending: true },
  { year: '2023', text: 'Apertura del corralón en Puerto Iguazú.', pending: true },
];

const process = [
  { step: '01', title: 'Recepción de materia prima', desc: 'Arcilla seleccionada de proveedores de la región.' },
  { step: '02', title: 'Preparación', desc: 'Molienda, homogenización y mezclado.' },
  { step: '03', title: 'Extrusión y corte', desc: 'Moldeo de piezas con corte automático.' },
  { step: '04', title: 'Secado', desc: 'Secado controlado para evitar deformaciones.' },
  { step: '05', title: 'Cocción', desc: 'Hornos cerámicos a temperatura controlada.' },
  { step: '06', title: 'Control de calidad', desc: 'Verificación de dimensiones, resistencia y aspecto.' },
  { step: '07', title: 'Pallets y despacho', desc: 'Palletizado, identificación y logística.' },
];

const values = [
  { title: 'Trayectoria', desc: 'Décadas de actividad industrial en la región.' },
  { title: 'Industria nacional', desc: 'Producción 100% argentina, en Misiones.' },
  { title: 'Compromiso regional', desc: 'Acompañamos el desarrollo constructivo del NEA.' },
  { title: 'Atención comercial', desc: 'Equipo que asesora en producto, cantidad y logística.' },
];
---

<BaseLayout
  title="Cerámica Puerto Rico | Fábrica de Ladrillos en Misiones"
  description="Conocé la historia, el proceso productivo y el compromiso de Cerámica Puerto Rico, fábrica de ladrillos cerámicos en Puerto Rico, Misiones."
  path="/empresa"
  breadcrumbs={breadcrumbs}
>
  <section class="page-hero">
    <div class="container">
      <span class="section-eyebrow">Empresa</span>
      <h1>Industria cerámica de Misiones, para la región</h1>
      <p class="page-hero-sub">
        Somos una fábrica de ladrillos cerámicos con planta en Puerto Rico, Misiones.
        Producimos los ladrillos con los que se construye nuestra región.
      </p>
    </div>
  </section>

  <!-- Historia + línea temporal -->
  <section class="section">
    <div class="container two-col">
      <div>
        <span class="section-eyebrow">Historia</span>
        <h2>Más de 50 años construyendo juntos</h2>
        <p>
          Cerámica Puerto Rico comunica actividad industrial desde 1975. Una cronología
          completa de la empresa —incluyendo los hitos fundacionales, las ampliaciones
          de planta y la apertura de nuevas unidades— está siendo validada con el
          cliente para incorporarla a esta sección.
        </p>
        <p>
          Si querés conocer más sobre nuestra historia o tenés material para
          compartirnos, escribinos por WhatsApp.
        </p>
      </div>

      <ol class="timeline">
        {timeline.map((t) => (
          <li>
            <span class="timeline-year">{t.year}</span>
            <span class="timeline-text">{t.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Fábrica -->
  <section class="section section--dark" id="proceso">
    <div class="container">
      <span class="section-eyebrow" style="color: var(--color-terracota-300);">Fábrica</span>
      <h2>Cómo fabricamos nuestros ladrillos</h2>
      <p style="color: var(--color-grafito-100); max-width: 60ch;">
        Un proceso controlado de punta a punta, desde la materia prima hasta el
        despacho en planta.
      </p>
      <ol class="process-list">
        {process.map((p) => (
          <li>
            <span class="step-num">{p.step}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Compromiso -->
  <section class="section" id="cobertura">
    <div class="container">
      <span class="section-eyebrow">Compromiso</span>
      <h2>Lo que nos diferencia</h2>
      <div class="grid grid-4">
        {values.map((v) => (
          <div class="card">
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight section--dark cta">
    <div class="container cta-block">
      <h2>Conocé nuestros productos</h2>
      <a href="/productos" class="btn btn-primary">Ir al catálogo</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--color-terracota-50);
    padding-block: var(--space-8);
  }
  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-3);
  }
  .page-hero-sub {
    color: var(--color-grafito-500);
    max-width: 60ch;
    margin: 0;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
  }
  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-terracota-500);
  }
  .timeline li {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-grafito-100);
  }
  .timeline-year {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-terracota-600);
  }
  .timeline-text { color: var(--color-grafito-700); }

  .process-list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }
  .process-list li {
    background: var(--color-grafito-700);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    display: flex;
    gap: var(--space-3);
  }
  .step-num {
    font-family: var(--font-mono);
    color: var(--color-terracota-300);
    font-weight: 700;
    flex-shrink: 0;
  }
  .process-list h3 { color: var(--color-blanco); font-size: var(--fs-300); margin: 0 0 var(--space-2); }
  .process-list p { color: var(--color-grafito-100); margin: 0; font-size: var(--fs-100); }

  .cta-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .cta-block h2 { color: var(--color-blanco); margin: 0; }
</style>
