---
/**
 * BaseLayout.astro — Layout raíz con header, footer, fuentes y SEO.
 * Carga Manrope desde Google Fonts (SPEC §29 — sans serif contemporánea).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; url: string }[];
  faqJsonLd?: { q: string; a: string }[];
  productJsonLd?: Record<string, unknown>;
}

const { title, description, path, ogImage, type, breadcrumbs, faqJsonLd, productJsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      type={type}
      breadcrumbs={breadcrumbs}
      faqJsonLd={faqJsonLd}
      productJsonLd={productJsonLd}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
  </body>
</html>
