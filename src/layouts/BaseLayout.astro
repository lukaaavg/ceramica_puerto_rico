---
/**
 * BaseLayout.astro — Layout raíz con header, footer, fuentes y SEO.
 * Carga Manrope desde Google Fonts (SPEC §29 — sans serif contemporánea).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BackToTop from '../components/BackToTop.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; url: string }[];
  faqJsonLd?: { q: string; a: string }[];
  productJsonLd?: Record<string, unknown>;
}

const { title, description, path, ogImage, type, breadcrumbs, faqJsonLd, productJsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      type={type}
      breadcrumbs={breadcrumbs}
      faqJsonLd={faqJsonLd}
      productJsonLd={productJsonLd}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <BackToTop />
  </body>

  <script>
    /* Header sombra al scrollear */
    const header = document.querySelector('.site-header');
    const backBtn = document.getElementById('back-to-top');

    function onScroll() {
      const scrolled = window.scrollY > 10;
      header?.classList.toggle('is-scrolled', scrolled);

      const showBtn = window.scrollY > Math.max(window.innerHeight * 0.5, 600);
      backBtn?.classList.toggle('is-visible', showBtn);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* Reveal animations — fade-in al entrar en viewport */
    /* Auto-marca las secciones internas como reveal si no tienen clase manual */
    document.querySelectorAll('main > section .container').forEach((el) => {
      if (!el.classList.contains('reveal') && !el.closest('.no-reveal')) {
        el.classList.add('reveal');
      }
    });
    const revealEls = document.querySelectorAll('.reveal');
    if (revealEls.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</html>
