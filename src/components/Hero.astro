---
/**
 * Hero.astro — bloque principal del Home.
 * SPEC §22: H1 + bajada + 2 CTA + badge "Desde 1975".
 * Imagen real cuando se entregue (acá se usa un placeholder visual).
 */
import { company } from '../data/company';

interface Props {
  title?: string;
  subtitle?: string;
  badge?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const {
  title = 'Ladrillos cerámicos hechos en Misiones para construir nuestra región',
  subtitle = 'Industria, experiencia y soluciones cerámicas para viviendas, obras y desarrollos del NEA.',
  badge = 'Desde 1975',
  primaryCta = { href: '/productos', label: 'Ver productos' },
  secondaryCta = { href: '/contacto', label: 'Solicitar presupuesto' },
} = Astro.props;
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-pattern"></div>
    <svg class="hero-svg" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice">
      <defs>
        <linearGradient id="hero-brick" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#d9986c" stop-opacity="0.35"/>
          <stop offset="100%" stop-color="#7c3b21" stop-opacity="0.55"/>
        </linearGradient>
        <pattern id="bricks-pattern" x="0" y="0" width="80" height="36" patternUnits="userSpaceOnUse">
          <rect width="80" height="36" fill="none"/>
          <rect x="2" y="2" width="34" height="14" rx="2" fill="url(#hero-brick)"/>
          <rect x="42" y="2" width="34" height="14" rx="2" fill="url(#hero-brick)"/>
          <rect x="22" y="20" width="34" height="14" rx="2" fill="url(#hero-brick)"/>
        </pattern>
      </defs>
      <rect x="700" y="0" width="500" height="600" fill="url(#bricks-pattern)" opacity="0.6"/>
      <circle cx="980" cy="120" r="180" fill="#d9986c" opacity="0.15"/>
      <circle cx="1080" cy="450" r="120" fill="#7c3b21" opacity="0.10"/>
    </svg>
  </div>

  <div class="container hero-inner">
    <span class="hero-badge">
      <span class="hero-badge-dot" aria-hidden="true"></span>
      {badge}
    </span>
    <h1>{title}</h1>
    <p class="hero-sub">{subtitle}</p>
    <div class="hero-actions">
      <a href={primaryCta.href} class="btn btn-primary">{primaryCta.label}</a>
      <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>
    </div>
    <p class="hero-meta">
      <span class="hero-meta-dot" aria-hidden="true"></span>
      Fábrica en {company.address.locality}, {company.address.province} · Tel {company.phone.display}
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg, var(--color-blanco-calido) 0%, var(--color-terracota-50) 100%);
    padding-block: var(--space-9) var(--space-10);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.7;
  }
  .hero-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(45deg,
        transparent 0 24px,
        rgba(184, 98, 59, 0.05) 24px 25px);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-grafito-900);
    color: var(--color-blanco);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: var(--fs-50);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
    box-shadow: 0 4px 12px rgba(15, 15, 18, 0.15);
  }
  .hero-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-terracota-500);
    box-shadow: 0 0 0 3px rgba(184, 98, 59, 0.25);
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }
  .hero-sub {
    font-size: var(--fs-400);
    color: var(--color-grafito-500);
    max-width: 60ch;
    margin-bottom: var(--space-6);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-100);
    color: var(--color-grafito-500);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    border: 1px solid var(--color-grafito-100);
  }
  .hero-meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-terracota-500);
  }
</style>
