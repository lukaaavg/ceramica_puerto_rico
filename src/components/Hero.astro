---
/**
 * Hero.astro — bloque principal según la referencia Stitch:
 * columna de texto (eyebrow, H1, bajada, 2 CTA, chips de confianza)
 * + tarjeta de imagen con badge naranja superpuesto.
 * SPEC §22.
 */

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}

const {
  eyebrow = 'Solidez estructural y aislación térmica',
  title = 'Vos construís, nosotros lo llevamos.',
  subtitle = 'Ladrillos cerámicos huecos y portantes producidos en nuestra fábrica de Puerto Rico, Misiones. Stock constante, logística propia y el precio de fábrica.',
  primaryCta = { href: '/productos', label: 'Explorar Catálogo' },
  secondaryCta = { href: '/contacto', label: 'Pedir Presupuesto' },
} = Astro.props;

const trustPoints = [
  'Presupuesto sin cargo',
  'Stock constante',
  'Acompañamos tu obra',
];
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="section-eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="hero-sub">{subtitle}</p>

      <div class="hero-actions">
        <a href={primaryCta.href} class="btn btn-primary btn-lg">{primaryCta.label}</a>
        <a href={secondaryCta.href} class="btn btn-secondary btn-lg">
          {secondaryCta.label}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <ul class="hero-trust">
        {trustPoints.map((t) => (
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            {t}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-media">
      <img
        class="hero-photo"
        src="/images/planta/horno-pallets-1.webp"
        alt="Pallet de ladrillos cerámicos entrando al horno de la planta de Puerto Rico, Misiones"
        width="1600"
        height="1451"
        fetchpriority="high"
        decoding="async"
      />

      <div class="hero-badge">
        <p class="hero-badge-title">Stock constante</p>
        <p class="hero-badge-text">
          Ladrillo hueco 12x18x24 en planta
        </p>
        <a href="/productos/12x18x24-visto" class="hero-badge-link">
          Ver ese producto
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
               stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-8);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-8);
    align-items: center;
  }

  h1 {
    font-size: clamp(2.125rem, 4vw, 3.25rem);
    margin-bottom: var(--space-4);
  }
  .hero-sub {
    color: var(--text-muted);
    font-size: var(--fs-300);
    line-height: 1.6;
    max-width: 54ch;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-100);
    color: var(--text-muted);
  }
  .hero-trust svg { color: var(--accent); flex-shrink: 0; }

  /* — Media — */
  .hero-media {
    position: relative;
    padding-bottom: var(--space-6);
    aspect-ratio: 4 / 3;
  }
  .hero-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .hero-badge {
    position: absolute;
    left: calc(var(--space-5) * -1);
    bottom: 0;
    max-width: 300px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: 0 10px 26px rgba(176, 58, 22, 0.32);
  }
  .hero-badge-title {
    margin: 0 0 0.2rem;
    font-size: var(--fs-300);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .hero-badge-text {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-50);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-badge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #fff;
    font-size: var(--fs-100);
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    padding-bottom: 1px;
  }
  .hero-badge-link:hover { color: #fff; border-bottom-color: #fff; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero-media { padding-bottom: 0; }
    .hero-badge {
      position: static;
      max-width: none;
      margin-top: calc(var(--space-4) * -1);
      margin-left: var(--space-4);
    }
  }
</style>
