---
/**
 * WhatsAppButton.astro — botón flotante sticky.
 * SPEC §22: en móvil WhatsApp sticky.
 */
import { company } from '../data/company';

const message = encodeURIComponent(
  'Hola, estoy visitando su sitio web y me gustaría hacer una consulta.'
);
const href = `https://wa.me/${company.branches[0].whatsapp}?text=${message}`;
---

<a
  href={href}
  class="wa-float"
  target="_blank"
  rel="noopener"
  aria-label="Contactar por WhatsApp"
>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <path
      fill="#ffffff"
      d="M16 3C9.4 3 4 8.4 4 15c0 2.5.8 4.8 2.2 6.8L4 29l7.4-2.2c1.4.6 3 .9 4.6.9 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-4.4 1.3 1.3-4.3-.2-.3a9.7 9.7 0 0 1-1.5-5.2c0-5.4 4.4-9.7 9.7-9.7s9.7 4.4 9.7 9.7-4.3 9.8-9.7 9.8zM21.6 18c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.8.9-1 1.1-.2.2-.4.2-.6 0-.3-.2-1.2-.4-2.3-1.4-.8-.7-1.4-1.7-1.6-2-.2-.3 0-.5.1-.7l.4-.5c.2-.2.2-.4.4-.6.1-.2 0-.4 0-.6 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2 2.8 1.2 2.8.8 3.3.8.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3z"
    />
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-acento-cta);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-lg);
    transition: transform var(--t-fast), background var(--t-fast);
  }
  .wa-float:hover {
    background: var(--color-acento-cta-hover);
    transform: scale(1.05);
  }
  @media (max-width: 480px) {
    .wa-float { width: 52px; height: 52px; right: 14px; bottom: 14px; }
  }
</style>
