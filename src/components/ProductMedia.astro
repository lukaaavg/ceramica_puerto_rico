---
/**
 * ProductMedia.astro — imagen de un producto, con fallback al dibujo SVG.
 *
 * Delega la resolucion a src/lib/productImage.ts, que la comparten este
 * componente y la ficha de producto, para que no se duplique la logica.
 */
import type { Product } from '../data/products';
import { resolveProductImage, FALLBACK_RATIO } from '../lib/productImage';
import BrickIllustration from './BrickIllustration.astro';

interface Props {
  product: Product;
  size?: 'card' | 'detail';
  class?: string;
}

const { product, size = 'card', class: className } = Astro.props;

const src = resolveProductImage(product);
const alt = product.imageAlt ?? product.name;

const ratio = FALLBACK_RATIO[size];
const width = 1200;
const height = Math.round(width / ratio);
---

{
  src ? (
    <img
      class:list={['product-media-img', className]}
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={size === 'detail' ? 'eager' : 'lazy'}
      decoding="async"
      data-product={product.slug}
    />
  ) : (
    <div class="product-media-svg" data-fallback={product.slug}>
      <BrickIllustration product={product} size={size} />
    </div>
  )
}

<style>
  .product-media-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--surface-alt);
  }
  .product-media-svg {
    line-height: 0;
  }
  .product-media-svg :global(.brick-wrap) {
    border-radius: 0;
  }
</style>
